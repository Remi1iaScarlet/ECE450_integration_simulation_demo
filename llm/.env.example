# LLM Configuration
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# For Anthropic Claude
LLM_API_KEY=sk-ant-xxxxx
LLM_MODEL=claude-sonnet-4-20250514

# For OpenAI GPT (uncomment and fill if using OpenAI)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxx
# LLM_MODEL=gpt-4o

# Database path (relative to project root)
DATABASE_PATH=data/queue.db

# Server settings (only needed if not using Caddy)
HOST=127.0.0.1
PORT=8000
